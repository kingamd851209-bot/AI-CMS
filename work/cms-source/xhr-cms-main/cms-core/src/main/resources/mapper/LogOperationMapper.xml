<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.xinhongru.mapper.LogOperationMapper">
    <sql id="BASE_TABLE">
        t_logs_operation
    </sql>
    <insert id="add">
        insert into
        <include refid="BASE_TABLE"></include>
        (action,request_data,user_id,ip,created,response_data,user_name,class_id,info_id)
        values
        (#{action},#{requestData},#{userId},#{ip},#{created},#{responseData},#{userName},#{classId},#{infoId})
    </insert>
    <resultMap id="customMap" type="com.xinhongru.entity.LogOperationEntity">
        <result column="created" property="created" javaType="java.time.LocalDateTime"
                jdbcType="TIMESTAMP"
                typeHandler="com.xinhongru.typeHandler.LocalDateTimeTypeHandler"/>
    </resultMap>
    <select id="getListByClassIdAndInfoId" resultType="com.xinhongru.entity.LogOperationEntity" resultMap="customMap">
        select *
        from
        <include refid="BASE_TABLE"></include>
        where class_id=#{classId} and info_id=#{infoId}
        order by id desc
    </select>

    <select id="getRecentLogs" resultType="com.xinhongru.entity.LogOperationEntity" resultMap="customMap">
        select *
        from
        <include refid="BASE_TABLE"></include>
        order by id desc
        limit #{limit}
    </select>

    <select id="getLogList" resultType="com.xinhongru.entity.LogOperationEntity" resultMap="customMap">
        select *
        from
        <include refid="BASE_TABLE"></include>
        <where>
            <if test="query.userId>0">and user_id=#{query.userId}</if>
            <if test="query.beginTime!=null">and created &gt;= concat(#{query.beginTime},' 00:00:00')</if>
            <if test="query.endTime!=null">and created &lt;= concat(#{query.endTime},' 23:59:59')</if>
            <if test="query.key!=null">and action like concat('%',#{query.key},'%')</if>
        </where>
        order by id desc
    </select>

    <select id="getLogById" resultType="com.xinhongru.entity.LogOperationEntity" resultMap="customMap">
        select *
        from
        <include refid="BASE_TABLE"></include>
        where id=#{id}
        limit 1
    </select>

</mapper>