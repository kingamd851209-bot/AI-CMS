<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.xinhongru.mapper.FieldSettingMapper">

    <sql id="orderCommon">
        order by sort desc, id asc
    </sql>
    <update id="updateModelField">
        update t_oneshot
        <set>
            <if test="fieldListDisplayJson!=null">
                model_list=#{fieldListDisplayJson},
            </if>
            <if test="fieldSearchJson!=null">
                model_search=#{fieldSearchJson},
            </if>
            <if test="fieldOptionsJson!=null">
                <if test="type==1">
                    menu_field=#{fieldOptionsJson},
                </if>
                <if test="type==0">
                    model_field=#{fieldOptionsJson},
                </if>
            </if>
        </set>
        <where>
            id=#{id}
        </where>
    </update>
    <select id="getFieldSettingList" resultType="com.xinhongru.content.model.ContentFieldDefinition">
        select
        id,field_name as fieldName,from_name as fromName,field_type as fieldType,type,bak,sort
        from t_fieldsetting
        where type=#{type}
        <include refid="orderCommon"></include>
    </select>
</mapper>
