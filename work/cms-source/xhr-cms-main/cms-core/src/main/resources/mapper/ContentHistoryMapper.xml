<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.xinhongru.mapper.ContentHistoryMapper">
    <insert id="save">
        insert into t_contents_history
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="contentId!=null">content_id,</if>
            <if test="menuId!=null">menu_id,</if>
            <if test="title!=null">title,</if>
            <if test="createTime!=null">create_time,</if>
            <if test="params!=null">params,</if>
            <if test="comparison!=null">comparison,</if>
            <if test="updateDescription!=null">update_description,</if>
            <if test="userId!=null">user_id,</if>
            <if test="userAccount!=null">user_account,</if>
            <if test="userName!=null">user_name,</if>
            <if test="checkStatus!=null">check_status,</if>
            <if test="checkDescription!=null">check_description,</if>
        </trim>
        <trim prefix=" values (" suffix=")" suffixOverrides=",">
            <if test="contentId!=null">#{contentId},</if>
            <if test="menuId!=null">#{menuId},</if>
            <if test="title!=null">#{title},</if>
            <if test="createTime!=null">#{createTime},</if>
            <if test="params!=null">#{params},</if>
            <if test="comparison!=null">#{comparison},</if>
            <if test="updateDescription!=null">#{updateDescription},</if>
            <if test="userId!=null">#{userId},</if>
            <if test="userAccount!=null">#{userAccount},</if>
            <if test="userName!=null">#{userName},</if>
            <if test="checkStatus!=null">#{checkStatus},</if>
            <if test="checkDescription!=null">#{checkDescription},</if>
        </trim>
    </insert>
    <update id="updateById">
        update t_contents_history
        <set>
            <if test="contentId!=null">content_id=#{contentId},</if>
            <if test="menuId!=null">menu_id=#{menuId},</if>
            <if test="title!=null">title=#{title},</if>
            <if test="createTime!=null">create_time=#{createTime},</if>
            <if test="params!=null">params=#{params},</if>
            <if test="comparison!=null">comparison=#{comparison},</if>
            <if test="updateDescription!=null">update_description=#{updateDescription},</if>
            <if test="userId!=null">user_id=#{userId},</if>
            <if test="userAccount!=null">user_account=#{userAccount},</if>
            <if test="userName!=null">user_name=#{userName},</if>
            <if test="checkStatus!=null">check_status=#{checkStatus},</if>
            <if test="checkDescription!=null">check_description=#{checkDescription},</if>
        </set>
        where id=#{id}
    </update>

    <select id="getById" resultType="com.xinhongru.entity.ContentHistoryEntity">
        select *
        from t_contents_history
        where id = #{historyId}
    </select>
    <select id="list" resultType="com.xinhongru.entity.ContentHistoryEntity">
        select *
        from t_contents_history
        where content_id = #{infoId}
          and menu_id = #{classId}
        order by create_time desc
    </select>
</mapper>
