<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.xinhongru.mapper.UserMapper">
    <sql id="BASE_TABLE">
        t_users
    </sql>
    <resultMap id="customMap" type="com.xinhongru.entity.UserEntity">
        <result column="last_login_time" property="lastLoginTime" javaType="java.time.LocalDateTime"
                jdbcType="TIMESTAMP"
                typeHandler="com.xinhongru.typeHandler.LocalDateTimeTypeHandler"/>
    </resultMap>
    <sql id="BASE_COLUMN">
        id,username,password,email,home_url,screen_name,created,activated,logged,group_name,last_login_time,login_times,last_login_ip,group_id
    </sql>
    <insert id="addUser" useGeneratedKeys="true" keyProperty="id">
        insert into
        <include refid="BASE_TABLE"></include>
        (username,password,email,screen_name,group_id,created)
        values
        (#{username},#{password},#{email},#{screenName},#{groupId},#{created})
    </insert>

    <update id="updateUserInfo" parameterType="com.xinhongru.entity.UserEntity">
        UPDATE
        <include refid="BASE_TABLE"/>
        <set>
            <if test="password != null">
                password = #{password, jdbcType=VARCHAR},
            </if>
            <if test="screenName != null">
                screen_name = #{screenName, jdbcType=VARCHAR},
            </if>
            <if test="email != null">
                email = #{email, jdbcType=VARCHAR},
            </if>
            <if test="homeUrl != null">
                home_url = #{homeUrl, jdbcType=VARCHAR},
            </if>
            <if test="groupId!=null">
                group_id=#{groupId, jdbcType=INTEGER},
            </if>
            <if test="lastLoginTime!=null">
                last_login_time=#{lastLoginTime, jdbcType=TIMESTAMP},
            </if>
            <if test="lastLoginIp!=null">
                last_login_ip=#{lastLoginIp, jdbcType=TIMESTAMP},
            </if>
            <if test="loginTimes!=null">
                login_times=#{loginTimes, jdbcType=INTEGER},
            </if>
            <if test="activated!=null">
                activated=#{activated, jdbcType=INTEGER},
            </if>
            <if test="logged!=null">
                logged=#{logged, jdbcType=INTEGER},
            </if>
        </set>
        WHERE id = #{id, jdbcType=INTEGER}
    </update>
    <delete id="deleteUser">
        delete
        from t_users
        where id = #{id}
    </delete>

    <select id="getUserInfoById" resultType="com.xinhongru.entity.UserEntity" resultMap="customMap">
        SELECT
        <include refid="BASE_COLUMN"/>
        FROM
        <include refid="BASE_TABLE"/>
        WHERE
        id = #{id, jdbcType=INTEGER}
    </select>

    <select id="lockUserById" resultType="com.xinhongru.entity.UserEntity" resultMap="customMap">
        SELECT <include refid="BASE_COLUMN"/>
        FROM <include refid="BASE_TABLE"/>
        WHERE id = #{id, jdbcType=INTEGER}
        FOR UPDATE
    </select>

    <select id="getUserInfoByCond" resultType="com.xinhongru.entity.UserEntity" resultMap="customMap">
        SELECT
        <include refid="BASE_COLUMN"/>
        FROM
        <include refid="BASE_TABLE"/>
        <where>
            <if test="username != null">
                AND username = #{username, jdbcType=VARCHAR}
            </if>
            <if test="password != null">
                AND password = #{password, jdbcType=VARCHAR}
            </if>
        </where>
    </select>
    <select id="getUserList" resultType="com.xinhongru.entity.UserEntity" resultMap="customMap">
        select id,screen_name,email,username,home_url,activated,last_login_time,login_times,last_login_ip,group_id from
        <include refid="BASE_TABLE"/>
        order by id asc
    </select>
    <select id="hasUsername" resultType="java.lang.Integer">
        select count(1)
        from t_users
        where username = #{username}
    </select>
    <select id="hasEmail" resultType="java.lang.Integer">
        select count(1)
        from t_users
        where email = #{email}
    </select>
    <select id="getUserListByGroupId" resultType="com.xinhongru.entity.UserEntity" resultMap="customMap">
        SELECT
        <include refid="BASE_COLUMN"/>
        FROM
        <include refid="BASE_TABLE"/>
        where
        group_id = #{groupId}
        OR EXISTS (
            SELECT 1 FROM t_user_site_group assignment
            WHERE assignment.user_id = t_users.id AND assignment.group_id = #{groupId}
        )
    </select>
    <select id="getUserInfoByUserName" resultType="com.xinhongru.entity.UserEntity" resultMap="customMap">
        SELECT
        <include refid="BASE_COLUMN"/>
        FROM
        <include refid="BASE_TABLE"/>
        WHERE username = #{username, jdbcType=VARCHAR}
    </select>


</mapper>
