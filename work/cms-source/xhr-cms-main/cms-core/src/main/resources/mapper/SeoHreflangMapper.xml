<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xinhongru.mapper.SeoHreflangMapper">
    <select id="selectBySiteId" resultType="com.xinhongru.entity.SeoHreflangEntity">
        SELECT * FROM seo_hreflang WHERE site_id = #{siteId} AND deleted = 0 ORDER BY create_time DESC
    </select>
</mapper>
